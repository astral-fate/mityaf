{
  "name": "mityaf",
  "version": "1.0.0",
  "private": true,
  "description": "مِطياف — satellite urban-water intelligence for Al Madinah Municipality",
  "license": "MIT",
  "workspaces": [
    "apps/web",
    "packages/pipeline"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "npm run dev --workspace=@mityaf/web",
    "build": "npm run build --workspace=@mityaf/web",
    "start": "npm run start --workspace=@mityaf/web",
    "lint": "npm run lint --workspace=@mityaf/web",
    "pipeline": "node --env-file-if-exists=.env packages/pipeline/src/cli.js",
    "pipeline:units": "npm run pipeline -- build-units",
    "pipeline:weather": "npm run pipeline -- backfill-weather",
    "pipeline:s2": "npm run pipeline -- backfill-s2",
    "pipeline:export": "npm run pipeline -- export-static",
    "pipeline:all": "npm run pipeline -- all"
  },
  "dependencies": {
    "geotiff": "^3.0.5",
    "pg": "^8.23.0",
    "xlsx": "^0.18.5"
  }
}
