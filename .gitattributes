# Normalise line endings so the repo is identical on Windows, macOS and CI.
* text=auto eol=lf

# Binary assets must never be touched.
*.pdf   binary
*.woff2 binary
*.png   binary
*.jpg   binary

# Generated map payloads: keep diffs collapsed in review.
apps/web/public/data/*.geojson linguist-generated=true -diff
apps/web/public/data/*.json    linguist-generated=true -diff
