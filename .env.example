# ── Postgres (Neon) ────────────────────────────────────────────────────────
# Create a project at neon.tech, then copy the POOLED connection string
# (it has "-pooler" in the host). PostGIS is enabled automatically by the
# pipeline on first run.
#   postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=
PG_POOL_MAX=10

# ── Google Earth Engine ────────────────────────────────────────────────────
# Server-side auth uses a SERVICE ACCOUNT, not your personal login.
#   1. Google Cloud console -> IAM -> Service Accounts -> create
#   2. Grant it "Earth Engine Resource Viewer"
#   3. Create a JSON key and download it
#   4. Register the service account e-mail at:
#      https://signup.earthengine.google.com/#!/service_accounts
#   5. Paste the ENTIRE key JSON on one line below (or set it in Vercel/CI secrets)
GEE_PROJECT=dotted-medley-467420-k3
GEE_SERVICE_ACCOUNT_KEY=

# ── Area of interest (Al Madinah urban envelope) ───────────────────────────
AOI_MIN_LON=39.50
AOI_MIN_LAT=24.36
AOI_MAX_LON=39.72
AOI_MAX_LAT=24.58

# ── Detector thresholds (documented in the BRD) ────────────────────────────
RAINLESS_GATE_MM=1.0
RAINLESS_GATE_DAYS=3
RAIN_EVENT_MIN_MM=5.0
WASTE_Z_THRESHOLD=2.0
WASTE_MIN_PASSES=2
SAR_OPEN_DB=-3.0
SAR_URBAN_DB=2.5
SAR_BUILT_SPLIT=0.4

# ── Alerts ─────────────────────────────────────────────────────────────────
ALERTS_ENABLED=true
ALERTS_DRY_RUN=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
