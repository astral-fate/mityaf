# ── Postgres (Neon) ────────────────────────────────────────────────────────
# Create a project at neon.tech, then copy the POOLED connection string
# (it has "-pooler" in the host). PostGIS is enabled automatically by the
# pipeline on first run.
#   postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=
PG_POOL_MAX=10

# ── Google Earth Engine ────────────────────────────────────────────────────
# Server-side auth uses a SERVICE ACCOUNT, not your personal login.
#
#   1. Register the Cloud project for Earth Engine (this replaced the old
#      signup.earthengine.google.com/#!/service_accounts portal, which is gone —
#      service accounts now inherit access from the project):
#        https://console.cloud.google.com/earth-engine?project=dotted-medley-467420-k3
#   2. Enable the Earth Engine API on the same project:
#        https://console.cloud.google.com/apis/library/earthengine.googleapis.com
#   3. IAM & Admin -> Service Accounts -> CREATE SERVICE ACCOUNT
#   4. Grant it BOTH roles. Viewer alone authenticates and then fails on the
#      first reduceRegions, which is a confusing way to find out:
#        - Earth Engine Resource Writer   (roles/earthengine.writer)
#            "perform interactive computations" — the pipeline is all computation
#        - Service Usage Consumer         (roles/serviceusage.serviceUsageConsumer)
#            required by ee.Initialize(project=...) to bill the project
#   5. Keys -> ADD KEY -> Create new key -> JSON -> download
#   6. Put the key below, either way:
#        raw JSON on ONE line   — do NOT wrap it in quotes. Node expands \n
#                                 inside double-quoted env values, which turns
#                                 the private key into invalid JSON.
#        or base64             — safer for Vercel, where the dashboard field
#                                 mangles long single-line values:
#                                   base64 -w0 key.json
#
# Then check it end to end:  npm run pipeline -- doctor
GEE_PROJECT=dotted-medley-467420-k3
GEE_SERVICE_ACCOUNT_KEY=

# ── Area of interest (Al Madinah urban envelope) ───────────────────────────
AOI_MIN_LON=39.50
AOI_MIN_LAT=24.36
AOI_MAX_LON=39.72
AOI_MAX_LAT=24.58

# ── Detector thresholds (documented in the BRD) ────────────────────────────
RAINLESS_GATE_MM=1.0
RAINLESS_GATE_DAYS=3
RAIN_EVENT_MIN_MM=5.0
WASTE_Z_THRESHOLD=2.0
WASTE_MIN_PASSES=2
SAR_OPEN_DB=-3.0
SAR_URBAN_DB=2.5
SAR_BUILT_SPLIT=0.4

# ── Alerts ─────────────────────────────────────────────────────────────────
ALERTS_ENABLED=true
ALERTS_DRY_RUN=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
